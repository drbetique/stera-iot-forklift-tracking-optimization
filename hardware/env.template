# Stera Forklift IoT Configuration
# Copy this file to .env and update values

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=forklift/mpu6050

# InfluxDB v3 Settings (High-frequency time-series storage)
INFLUX_HOST=http://127.0.0.1:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=HAMK
INFLUX_DATABASE=forklift_data

# MongoDB Backend Settings (Aggregated telemetry for dashboard)
BACKEND_URL=http://localhost:3001/api/telemetry

# Data Aggregation Settings
AGGREGATE_INTERVAL=10          # seconds between MongoDB updates
AGGREGATE_SAMPLE_SIZE=50       # number of samples to average

# Default Forklift ID (can be overridden in MQTT payload)
FORKLIFT_ID=forklift_1
